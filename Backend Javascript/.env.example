NODE_ENV=development
PORT=3000
LOG_LEVEL=info
DATABASE_URL=postgresql://user:password@localhost:5432/tributario
DIRECT_URL=postgresql://user:password@localhost:5432/tributario
FASTAPI_BASE_URL=http://localhost:8000
JWT_SECRET=change-me-use-at-least-16-chars
JWT_ACCESS_TTL=15m
SESSION_IDLE_TIMEOUT_MINUTES=30
SESSION_DEFAULT_DAYS=7
SESSION_REMEMBER_DAYS=30
# Solo para desarrollo local. No configurar en producción.
AUTH_TEST_ADMIN_EMAIL=capstonepicdt@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=capstonepicdt@gmail.com
SMTP_PASS=replace-with-google-app-password
MAIL_FROM="Sistema Capstone <capstonepicdt@gmail.com>"
MAX_FILE_SIZE_MB=15
MAX_BATCH_SIZE=10
APP_ORIGIN=http://localhost:5173
GEMINI_API_KEY=replace-with-gemini-api-key
GEMINI_MODEL=gemini-2.0-flash
GEMINI_LIVE_TESTS=false
DOCUMENT_STORAGE_PATH=./storage/documents
