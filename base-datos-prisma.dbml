  USUARIO
  ADMINISTRADOR
}

Enum estado_usuario {
  PENDIENTE
  ACTIVO
  BLOQUEADO
  INACTIVO
}

Enum estado_solicitud {
  PENDIENTE
  APROBADA
  RECHAZADA
}

Enum tipo_token_seguridad {
  CODIGO_INICIO_SESION
  RECUPERACION_PASSWORD
  VERIFICACION_CORREO
}

Enum tipo_evento_seguridad {
  LOGIN_EXITOSO
  LOGIN_FALLIDO
  CODIGO_INVALIDO
  CUENTA_BLOQUEADA
  CAMBIO_PASSWORD
  RECUPERACION_SOLICITADA
  SESION_CERRADA
}

Enum estado_documento {
  PENDIENTE
  PROCESANDO
  PENDIENTE_REVISION
  ERROR
  CONFIRMADO
}

Enum estado_extraccion {
  ENCONTRADO
  AUSENTE
  NO_APLICA
  ILEGIBLE
  INCIERTO
}

Enum tipo_ajuste {
  DESCUENTO
  RECARGO
}

Enum modalidad_ajuste {
  PORCENTAJE
  MONTO
}

Enum estado_revision {
  PENDIENTE
  EDITANDO
  CONFIRMADA
}

Enum direccion_documento {
  COMPRA
  VENTA
}

Enum rol_mensaje_chat {
  USUARIO
  ASISTENTE
}

Enum condicion_tributaria {
  AFECTA
  EXENTA
  NO_AFECTA
  MIXTA
}

