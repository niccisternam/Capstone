}

Ref fk_usuario_empresa: usuario.id_empresa - empresa.id_empresa [delete: restrict]
Ref fk_solicitud_revisor: solicitud_cuenta.revisada_por > usuario.id_usuario [delete: set null]
Ref fk_sesion_usuario: sesion_usuario.id_usuario > usuario.id_usuario [delete: cascade]
Ref fk_token_usuario: token_seguridad.id_usuario > usuario.id_usuario [delete: cascade]
Ref fk_evento_usuario: evento_seguridad.id_usuario > usuario.id_usuario [delete: set null]
Ref fk_notebook_empresa: notebook.id_empresa > empresa.id_empresa [delete: restrict]
Ref fk_notebook_creador: notebook.creado_por > usuario.id_usuario [delete: restrict]
Ref fk_lote_empresa: lote_procesamiento.id_empresa > empresa.id_empresa [delete: restrict]
Ref fk_lote_empresa_notebook: lote_procesamiento.(id_empresa, id_notebook) > notebook.(id_empresa, id_notebook) [delete: restrict]
Ref fk_lote_creador: lote_procesamiento.creado_por > usuario.id_usuario [delete: restrict]
Ref fk_documento_empresa: documento.id_empresa > empresa.id_empresa [delete: restrict]
Ref fk_documento_empresa_notebook: documento.(id_empresa, id_notebook) > notebook.(id_empresa, id_notebook) [delete: restrict]
Ref fk_documento_empresa_lote: documento.(id_empresa, id_lote) > lote_procesamiento.(id_empresa, id_lote) [delete: restrict]
Ref fk_documento_cargador: documento.cargado_por > usuario.id_usuario [delete: restrict]
Ref fk_archivo_documento: archivo_pdf.id_documento - documento.id_documento [delete: cascade]
Ref fk_intento_documento: intento_procesamiento.id_documento > documento.id_documento [delete: cascade]
Ref fk_resultado_documento: resultado_extraccion.id_documento > documento.id_documento [delete: cascade]
Ref fk_resultado_intento: resultado_extraccion.id_intento - intento_procesamiento.id_intento [delete: cascade]
Ref fk_detalle_resultado: detalle_extraccion.id_resultado > resultado_extraccion.id_resultado [delete: cascade]
Ref fk_ajuste_resultado: ajuste_global_extraccion.id_resultado > resultado_extraccion.id_resultado [delete: cascade]
Ref fk_revision_documento: revision_documento.id_documento > documento.id_documento [delete: cascade]
Ref fk_revision_resultado: revision_documento.id_resultado > resultado_extraccion.id_resultado [delete: restrict]
Ref fk_revision_revisor: revision_documento.revisado_por > usuario.id_usuario [delete: restrict]
Ref fk_detalle_revision: detalle_revision.id_revision > revision_documento.id_revision [delete: cascade]
Ref fk_detalle_revision_extraccion: detalle_revision.id_detalle_extraccion > detalle_extraccion.id_detalle [delete: set null]
Ref fk_ajuste_revision: ajuste_global_revision.id_revision > revision_documento.id_revision [delete: cascade]
Ref fk_conversacion_chat_empresa_notebook: conversacion_chat.(id_empresa, id_notebook) > notebook.(id_empresa, id_notebook) [delete: cascade]
Ref fk_conversacion_chat_usuario: conversacion_chat.id_usuario > usuario.id_usuario [delete: cascade]
Ref fk_mensaje_chat_conversacion: mensaje_chat.id_conversacion > conversacion_chat.id_conversacion [delete: cascade]
